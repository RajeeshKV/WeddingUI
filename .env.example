# ─────────────────────────────────────────────────────────────────
# Wedding Site Configuration — copy to .env and customise
# ─────────────────────────────────────────────────────────────────

# VITE_SITE_MODE controls what loads at the root URL ( / )
#
#   "launcher"   — Theme gallery / picker page.
#                  Good for a demo or showcase deployment.
#
#   "wedding"    — Goes directly to the wedding site.
#                  Use this for a real couple's deployment.
#
VITE_SITE_MODE=wedding

# The theme to use when VITE_SITE_MODE=wedding
# (also the fallback theme in launcher mode when no ?theme= param is present)
#
# Available IDs:
#   eternal-bloom    — Lavender, dusty rose, pearl
#   midnight-vows    — Near-black, burgundy, antique gold
#   marigold-mandap  — Saffron, vermilion, ivory, antique gold
#   tuscan-romance   — Terracotta, olive, warm cream
#   pearl-atelier    — Porcelain, pearl, charcoal, silver
#   sakura-reverie   — Cherry-blossom pink, cream, plum
#   secret-garden    — Sage, forest green, parchment, gold
#   ocean-serenade   — Deep teal, sea glass, sand, pearl
#   cinema-paradiso  — Sepia, espresso, parchment, faded rose
#   celestial-promise — Indigo, midnight blue, lavender, silver
#
VITE_DEFAULT_THEME=eternal-bloom
