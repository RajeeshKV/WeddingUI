# ─────────────────────────────────────────────────────────────────
# Wedding Site — copy this file to .env and fill in real values
# ─────────────────────────────────────────────────────────────────

# Required for ALL frontends ──────────────────────────────────────
VITE_API_BASE_URL=https://your-backend-domain.com

# ── Public Wedding Site only ──────────────────────────────────────
# Slug generated by Super User when creating an admin.
# Find it in the SU panel under "Admins → defaultWeddingSlug".
VITE_WEDDING_SLUG=replace-with-real-slug

# "launcher"  → / shows the theme picker page (demo/showcase deployment)
# "wedding"   → / goes straight to the wedding site (couple's own deployment)
VITE_SITE_MODE=wedding

# Active theme for wedding mode. Available IDs:
#   eternal-bloom | midnight-vows | marigold-mandap | tuscan-romance
#   pearl-atelier | sakura-reverie | secret-garden  | ocean-serenade
#   cinema-paradiso | celestial-promise
VITE_DEFAULT_THEME=eternal-bloom

# ── Admin Panel only ──────────────────────────────────────────────
# Only VITE_API_BASE_URL is needed. No slug required.

# ── Super User Panel only ─────────────────────────────────────────
# Only VITE_API_BASE_URL is needed. No slug required.
